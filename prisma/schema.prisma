generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model MatchResult {
  id              Int      @id @default(autoincrement())
  article         String
  productName     String
  confidenceScore Int
  estimatedCost   Float
  category        String
  material        String
  createdAt       DateTime @default(now())
}

model Machine {
  id          Int      @id @default(autoincrement())
  name        String
  type        String
  materials   String
  maxPressure Float?
  hourlyRate  Int?
  status      String   @default("IDLE") // IDLE, ACTIVE, MAINTENANCE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
